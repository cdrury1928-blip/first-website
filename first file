<header>
  <div class="headbar">
    <button class="brand" data-goto="home">
      <svg viewBox="0 0 32 32" fill="none"><path d="M16 4c-6 0-10 4.2-10 10 0 7 6 12 10 14 4-2 10-7 10-14 0-5.8-4-10-10-10Z" fill="#C1901F"/><path d="M16 2c1 2 0.5 4-1 5" stroke="#3E5631" stroke-width="1.6" stroke-linecap="round"/></svg>
