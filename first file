</header>

<main>

  <!-- ============ HOME ============ -->
  <div class="panel is-active" id="panel-home" role="tabpanel">
    <section class="hero" style="padding-top:76px;">
      <div class="wrap">
        <div>
          <div class="eyebrow-badge">
            <span class="stars">★★★★☆</span>
            <span>4.4 from 34 shoppers in Gympie</span>
          </div>
          <h1>Fresh for your kitchen. Better for your table.</h1>
