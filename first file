<script>
  (function(){
    var tabs = document.querySelectorAll('[data-goto]');
    var panels = document.querySelectorAll('.panel');

    function showSection(name, pushHash){
      panels.forEach(function(p){
        p.classList.toggle('is-active', p.id === 'panel-' + name);
      });
      document.querySelectorAll('.tabnav button').forEach(function(b){
        b.setAttribute('aria-selected', b.dataset.goto === name ? 'true' : 'false');
      });
      if (pushHash !== false) {
        history.replaceState(null, '', '#' + name);
      }
      window.scrollTo({top:0, behavior:'auto'});
    }

    tabs.forEach(function(el){
      el.addEventListener('click', function(){
        showSection(el.dataset.goto);
      });
    });

    var initial = (location.hash || '#home').replace('#','');
    var valid = ['home','about','menu','visit','reviews'];
    showSection(valid.indexOf(initial) !== -1 ? initial : 'home', false);

    document.querySelectorAll('.year').forEach(function(el){
      el.textContent = new Date().getFullYear();
    });
  })();
</script>
