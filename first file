<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Cooly Fruit Gold & Café — Fresh Produce, Gympie</title>
<meta name="description" content="Fresh fruit, vegetables and everyday groceries in Gympie QLD. Proudly local, in Goldfields Plaza on Nash St.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Work+Sans:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --paper:#F6F1E2;
    --ink:#242B1D;
    --green:#3E5631;
    --green-deep:#2A3B21;
    --gold:#C1901F;
    --berry:#7B2D3B;
    --crate:#B98247;
    --line: rgba(36,43,29,0.16);
    --radius: 2px;
  }
  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    margin:0;
    background:var(--paper);
    color:var(--ink);
    font-family:'Work Sans', sans-serif;
    font-size:16px;
    line-height:1.55;
  }
  h1,h2,h3,.display{
    font-family:'Fraunces', serif;
    font-weight:600;
    letter-spacing:-0.01em;
    margin:0;
    color:var(--green-deep);
  }
  a{color:inherit;}
  img,svg{max-width:100%;display:block;}
  .wrap{
    max-width:1080px;
    margin:0 auto;
    padding:0 28px;
  }
  @media (prefers-reduced-motion: reduce){
    *{animation:none !important; transition:none !important;}
  }
  button{font-family:inherit;}

  /* ---------- Header / tab nav ---------- */
  header{
    position:sticky; top:0; z-index:20;
    background:var(--paper);
    border-bottom:1px solid var(--line);
  }
  .headbar{
    display:flex; align-items:center; justify-content:space-between;
    padding:16px 28px;
    max-width:1080px; margin:0 auto;
    gap:20px;
    flex-wrap:wrap;
  }
  .brand{
    display:flex; align-items:center; gap:10px;
    font-family:'Fraunces', serif;
    font-weight:600; font-size:1.15rem;
    text-decoration:none; color:var(--green-deep);
    background:none; border:none; cursor:pointer; padding:0;
  }
  .brand svg{width:30px;height:30px;flex-shrink:0;}

  .tabnav{
    display:flex; gap:6px;
    flex-wrap:wrap;
  }
  .tabnav button{
    background:none;
    border:1px solid transparent;
    border-radius:999px;
    padding:8px 16px;
    font-size:0.92rem;
    font-weight:500;
    color:var(--ink);
    cursor:pointer;
  }
  .tabnav button:hover{ border-color:var(--line); }
  .tabnav button[aria-selected="true"]{
    background:var(--green-deep);
    color:var(--paper);
    font-weight:600;
  }

  /* ---------- Panels ---------- */
  .panel{ display:none; }
  .panel.is-active{ display:block; }

  /* ---------- Page hero (small, inner panels) ---------- */
  .page-hero{
    background:
      radial-gradient(ellipse at 18% -10%, rgba(193,144,31,0.20), transparent 55%),
      var(--green-deep);
    color:var(--paper);
    padding:56px 0;
    border-bottom:6px solid var(--gold);
  }
  .page-hero .kicker{
    display:block; color:var(--gold); font-weight:600; font-size:0.88rem; margin-bottom:10px;
  }
  .page-hero h1{
    color:var(--paper);
    font-size:clamp(2rem, 4vw, 2.8rem);
  }
  .page-hero p{
    margin-top:14px; max-width:52ch;
    color:rgba(246,241,226,0.82);
  }

  /* ---------- Hero (home panel, large) ---------- */
  .hero{
    background:
      radial-gradient(ellipse at 18% -10%, rgba(193,144,31,0.20), transparent 55%),
      var(--green-deep);
    color:var(--paper);
    padding:76px 0 64px;
    position:relative;
    overflow:hidden;
    border-bottom:6px solid var(--gold);
  }
  .hero .wrap{
    display:grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap:48px;
    align-items:center;
  }
  @media (max-width:860px){
    .hero .wrap{grid-template-columns:1fr;}
  }
  .eyebrow-badge{
    display:inline-flex; align-items:center; gap:8px;
    font-size:0.85rem;
    background:rgba(246,241,226,0.1);
    border:1px solid rgba(246,241,226,0.35);
    padding:6px 12px;
    border-radius:999px;
    margin-bottom:22px;
  }
  .stars{color:var(--gold); letter-spacing:1px;}
  .hero h1{
    font-size:clamp(2.3rem, 4.6vw, 3.6rem);
    color:var(--paper);
    line-height:1.06;
    max-width:12ch;
  }
  .hero p.lede{
    margin-top:18px;
    max-width:46ch;
    font-size:1.08rem;
    color:rgba(246,241,226,0.85);
  }
  .hero-actions{
    display:flex; gap:14px; margin-top:30px; flex-wrap:wrap;
  }
  .btn{
    display:inline-flex; align-items:center; gap:8px;
    padding:13px 22px;
    font-family:'Work Sans', sans-serif;
    font-weight:600; font-size:0.95rem;
    text-decoration:none;
    border-radius:var(--radius);
    border:1px solid transparent;
    cursor:pointer;
    background:none;
  }
  .btn-gold{ background:var(--gold); color:var(--green-deep); }
  .btn-gold:hover{ background:#d6a530; }
  .btn-outline{ border-color:rgba(246,241,226,0.5); color:var(--paper); }
  .btn-outline:hover{ border-color:var(--paper); }
  .btn-outline-dark{ border-color:var(--green-deep); color:var(--green-deep); }
  .btn-outline-dark:hover{ background:var(--green-deep); color:var(--paper); }

  .hero-card{
    background:var(--paper);
    color:var(--ink);
    padding:26px 26px 22px;
    border-radius:var(--radius);
    box-shadow: 6px 6px 0 rgba(0,0,0,0.18);
  }
  .hero-card dl{margin:0;}
  .hero-card .row{
    display:flex; gap:12px;
    padding:11px 0;
    border-top:1px solid var(--line);
    font-size:0.94rem;
  }
  .hero-card .row:first-child{border-top:none;}
  .hero-card .row .k{
    width:26px; color:var(--gold); flex-shrink:0; font-weight:700;
  }
  .hero-card .status{
    color:var(--green);
    font-weight:600;
  }

  /* ---------- Crate divider ---------- */
  .crate-strip{
    display:flex;
    background: repeating-linear-gradient(90deg, var(--crate) 0 46px, #a7723c 46px 48px);
    height:14px;
  }

  /* ---------- Section shell ---------- */
  section{padding:72px 0;}
  .section-head{
    max-width:56ch;
    margin-bottom:40px;
  }
  .section-head .kicker{
    display:block;
    color:var(--berry);
    font-weight:600;
    font-size:0.92rem;
    margin-bottom:10px;
  }
  .section-head h2{
    font-size:clamp(1.7rem, 3vw, 2.3rem);
  }
  .section-head p{
    margin-top:14px;
    color:rgba(36,43,29,0.78);
    font-size:1.02rem;
  }

  /* ---------- About ---------- */
  .about{
    display:grid;
    grid-template-columns: 1fr 1fr;
    gap:56px;
    align-items:center;
  }
  @media (max-width:820px){ .about{grid-template-columns:1fr;} }
  .about-copy p{margin:0 0 16px; color:rgba(36,43,29,0.85);}
  .about-copy p:last-child{margin-bottom:0;}
  .tags{
    display:flex; flex-wrap:wrap; gap:8px; margin-top:22px;
  }
  .tags span{
    font-size:0.82rem;
    padding:6px 12px;
    border:1px solid var(--line);
    border-radius:999px;
    color:var(--green);
  }

  /* ---------- Menu / crate labels ---------- */
  .menu-grid{
    display:grid;
    grid-template-columns: repeat(3, 1fr);
    gap:22px;
  }
  @media (max-width:820px){ .menu-grid{grid-template-columns:1fr 1fr;} }
  @media (max-width:560px){ .menu-grid{grid-template-columns:1fr;} }
  .crate{
    border:2px solid var(--green-deep);
    padding:22px 20px 20px;
    position:relative;
  }
  .crate::before{
    content:"";
    position:absolute; inset:6px;
    border:1px solid var(--green-deep);
    opacity:0.35;
    pointer-events:none;
  }
  .crate h3{
    font-size:1.25rem;
    color:var(--green-deep);
  }
  .crate .price-note{
    color:var(--berry);
    font-size:0.86rem;
    font-weight:600;
    margin-top:4px;
    display:block;
  }
  .crate ul{
    list-style:none; margin:16px 0 0; padding:0;
  }
  .crate li{
    display:flex; justify-content:space-between; gap:10px;
    padding:8px 0;
    border-top:1px dashed var(--line);
    font-size:0.94rem;
  }
  .crate li:first-child{border-top:none;}

  /* ---------- Visit / hours ---------- */
  .visit{
    display:grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap:48px;
  }
  @media (max-width:820px){ .visit{grid-template-columns:1fr;} }
  .hours-table{
    width:100%;
    border-collapse:collapse;
    margin-top:20px;
  }
  .hours-table td{
    padding:9px 0;
    border-top:1px solid var(--line);
    font-size:0.95rem;
  }
  .hours-table tr:first-child td{border-top:none;}
  .hours-table td:last-child{text-align:right; color:rgba(36,43,29,0.75);}
  .map-frame{
    border:1px solid var(--line);
    overflow:hidden;
    height:100%;
    min-height:320px;
  }
  .map-frame iframe{width:100%; height:100%; min-height:320px; border:0;}
  .contact-list{list-style:none; margin:20px 0 0; padding:0;}
  .contact-list li{
    display:flex; gap:12px; align-items:baseline;
    padding:9px 0;
    border-top:1px solid var(--line);
    font-size:0.95rem;
  }
  .contact-list li:first-child{border-top:none;}
  .contact-list .k{color:var(--gold); font-weight:700; width:20px; flex-shrink:0;}

  /* ---------- Reviews ---------- */
  .reviews-band{
    background:var(--green-deep);
    color:var(--paper);
    padding:64px 0;
  }
  .reviews-band .section-head h2{color:var(--paper);}
  .reviews-band .section-head .kicker{color:var(--gold);}
  .reviews-band .section-head p{color:rgba(246,241,226,0.75);}
  .rating-hero{
    display:flex; align-items:center; gap:22px;
    margin-bottom:36px;
    flex-wrap:wrap;
  }
  .rating-num{
    font-family:'Fraunces', serif;
    font-size:3.4rem;
    line-height:1;
    color:var(--gold);
  }
  .rating-meta .stars{font-size:1.2rem;}
  .rating-meta p{margin:4px 0 0; color:rgba(246,241,226,0.75); font-size:0.92rem;}
  .quote-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:22px;
  }
  @media (max-width:820px){ .quote-grid{grid-template-columns:1fr;} }
  .quote{
    border-top:2px solid var(--gold);
    padding-top:16px;
  }
  .quote p{margin:0; color:rgba(246,241,226,0.9); font-size:0.98rem;}
  .quote span.byline{
    display:block; margin-top:12px;
    font-size:0.85rem; color:rgba(246,241,226,0.6);
  }
  .quote .stars{font-size:0.9rem; margin-bottom:8px; display:block;}

  /* ---------- CTA band ---------- */
  .cta-band{
    background:rgba(193,144,31,0.1);
    padding:56px 0;
    text-align:center;
  }
  .cta-band h2{font-size:clamp(1.5rem, 3vw, 2rem);}
  .cta-band p{margin:14px auto 0; max-width:44ch; color:rgba(36,43,29,0.78);}
  .cta-band .hero-actions{justify-content:center; margin-top:26px;}

  /* ---------- Footer ---------- */
  footer{
    padding:48px 0 36px;
    border-top:1px solid var(--line);
  }
  .foot-grid{
    display:flex; justify-content:space-between; gap:24px; flex-wrap:wrap;
  }
  .foot-brand{
    font-family:'Fraunces', serif; font-weight:600; font-size:1.05rem; color:var(--green-deep);
  }
  .foot-brand p{
    font-family:'Work Sans', sans-serif;
    font-weight:400;
    color:rgba(36,43,29,0.7);
    font-size:0.9rem;
    margin-top:8px;
    max-width:34ch;
  }
  .foot-links{display:flex; gap:40px; flex-wrap:wrap;}
  .foot-links div h4{
    font-size:0.82rem; text-transform:none; color:var(--berry);
    margin:0 0 10px; font-weight:600;
  }
  .foot-links button, .foot-links a{
    display:block; text-decoration:none; font-size:0.9rem;
    color:var(--ink); padding:4px 0;
    background:none; border:none; text-align:left; cursor:pointer;
    font-family:inherit;
  }
  .foot-links button:hover, .foot-links a:hover{color:var(--gold);}
  .foot-bottom{
    margin-top:40px; padding-top:20px; border-top:1px solid var(--line);
    font-size:0.82rem; color:rgba(36,43,29,0.55);
  }
</style>
</head>
