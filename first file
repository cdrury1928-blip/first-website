          <rect x="30" y="332" width="360" height="18" fill="#8F5F31"/>
          <rect x="46" y="228" width="12" height="104" fill="#8F5F31"/>
          <rect x="362" y="228" width="12" height="104" fill="#8F5F31"/>
          <circle cx="120" cy="190" r="46" fill="#7B2D3B"/>
          <circle cx="200" cy="170" r="54" fill="#C1901F"/>
          <circle cx="285" cy="195" r="42" fill="#3E5631"/>
          <ellipse cx="150" cy="230" rx="70" ry="18" fill="#4B6B3A"/>
